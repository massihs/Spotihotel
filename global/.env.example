# ─── Core ─────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000
# 32+ random bytes, e.g. `openssl rand -base64 48`
APP_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# ─── Database ─────────────────────────────────────────
# Pooled URL used by the app
DATABASE_URL=postgres://spotihotel:spotihotel@localhost:5432/spotihotel_dev
# Direct (non-pooled) URL for migrations and LISTEN/NOTIFY realtime
DATABASE_URL_DIRECT=postgres://spotihotel:spotihotel@localhost:5432/spotihotel_dev
# Used by `npm test`
TEST_DATABASE_URL=postgres://spotihotel:spotihotel@localhost:5432/spotihotel_test

# ─── Storage (local | s3) ─────────────────────────────
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.storage
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# ─── Email (console | smtp | resend) ──────────────────
EMAIL_PROVIDER=console
EMAIL_FROM="Spotihotel <no-reply@spotihotel.local>"
SMTP_URL=smtp://localhost:1025
RESEND_API_KEY=

# ─── Edition (build time): global | iran ─────────────
# global: fr/en/fa/ar, EUR, Stripe — iran: fa/en/ar, IRR, Zarinpal. See docs/EDITIONS.md
NEXT_PUBLIC_EDITION=global

# ─── Payments ─────────────────────────────────────────
# Global edition
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Iran edition
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=false
# Enables the clearly-labelled fake online provider (never in production)
ENABLE_MOCK_PAYMENTS=true

# ─── Seed ─────────────────────────────────────────────
SEED_SUPERADMIN_EMAIL=admin@spotihotel.local
SEED_SUPERADMIN_PASSWORD=ChangeMe!2026
